  function updateCounts() {
    const items = document.querySelectorAll('#shopping-items [data-item]');
    const checked = document.querySelectorAll('#shopping-items [data-item] input:checked');
    const total = items.length;
    const done = checked.length;
    const remaining = total - done;

    const remainingText = document.getElementById('items-remaining-text');
    const progressPill = document.getElementById('progress-pill');
    const emptyState = document.getElementById('empty-state');
    const clearBtn = document.getElementById('clear-btn');

    if (total === 0) {
      remainingText.textContent = 'List is empty';
      emptyState.classList.remove('hidden');
      emptyState.classList.add('flex');
    } else {
      remainingText.textContent = remaining === 1 ? '1 item left' : `${remaining} items left`;
      emptyState.classList.add('hidden');
      emptyState.classList.remove('flex');
    }

    progressPill.textContent = `${done} / ${total}`;
    clearBtn.style.opacity = done > 0 ? '1' : '0.45';
    clearBtn.disabled = done === 0;
  }

  function toggleItem(checkbox) {
    const label = checkbox.closest('[data-item]');
    const textSpan = label.querySelector('span:last-child');
    if (checkbox.checked) {
      textSpan.classList.remove('text-on-surface');
      textSpan.classList.add('text-on-surface-variant', 'line-through', 'opacity-70');
    } else {
      textSpan.classList.add('text-on-surface');
      textSpan.classList.remove('text-on-surface-variant', 'line-through', 'opacity-70');
    }
    updateCounts();
  }

  function clearCompleted() {
    const checkedInputs = document.querySelectorAll('#shopping-items [data-item] input:checked');
    checkedInputs.forEach((input) => {
      const row = input.closest('[data-item]');
      row.style.opacity = '0';
      row.style.transform = 'translateX(12px)';
      setTimeout(() => {
        row.remove();
        updateCounts();
      }, 180);
    });
  }

  function addItem(event) {
    event.preventDefault();
    const input = document.getElementById('new-item-input');
    const value = input.value.trim();
    if (!value) return;

    const container = document.getElementById('shopping-items');
    const label = document.createElement('label');
    label.className = 'group flex items-center gap-space-sm min-h-[56px] px-2 rounded-xl cursor-pointer transition-all duration-200 hover:bg-surface-container-lowest/50 active:scale-[0.99] opacity-0 translate-y-2';
    label.setAttribute('data-item', '');

    label.innerHTML = `
      <span class="relative flex items-center justify-center w-12 h-12 -ml-2 shrink-0">
        <input type="checkbox" class="peer sr-only" onchange="toggleItem(this)">
        <span class="w-6 h-6 rounded-lg bg-surface-container-lowest/80 shadow-[inset_0_0_0_2px_#434655] peer-checked:bg-primary-container peer-checked:shadow-none flex items-center justify-center transition-all duration-200 peer-checked:scale-105">
          <span class="material-symbols-outlined text-on-primary text-[18px] opacity-0 peer-checked:opacity-100 transition-opacity duration-150" style="font-variation-settings: 'wght' 600;">check</span>
        </span>
      </span>
      <span class="font-body-lg text-body-lg text-on-surface flex-1 min-w-0 truncate transition-all duration-200"></span>
    `;
    label.querySelector('span:last-child').textContent = value;

    container.appendChild(label);
    requestAnimationFrame(() => {
      label.classList.remove('opacity-0', 'translate-y-2');
    });

    input.value = '';
    updateCounts();
  }

  updateCounts();
</script></main></body></html>

