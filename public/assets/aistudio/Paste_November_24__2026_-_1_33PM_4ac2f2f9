    const saveIcon = document.getElementById('save-icon');
    const fmtButtons = document.querySelectorAll('.fmt-btn');
    const undoBtn = document.getElementById('undo-btn');

    let saveTimer = null;

    function updateWordCount() {
      const text = (editor.innerText || '').trim();
      const words = text ? text.split(/\s+/).length : 0;
      metaEl.textContent = 'Oct 24 \u2022 ' + words + (words === 1 ? ' word' : ' words');
    }

    function triggerLocalSave() {
      saveText.textContent = 'Saving...';
      saveIcon.textContent = 'sync';
      saveIcon.classList.remove('text-tertiary');
      saveIcon.classList.add('text-primary-container');

      clearTimeout(saveTimer);
      saveTimer = setTimeout(function () {
        saveText.textContent = 'Saved locally';
        saveIcon.textContent = 'check_circle';
        saveIcon.classList.remove('text-primary-container');
        saveIcon.classList.add('text-tertiary');
      }, 450);
    }

    function syncToolbarState() {
      fmtButtons.forEach(function (btn) {
        const cmd = btn.getAttribute('data-cmd');
        let active = false;
        if (cmd === 'formatBlock') {
          active = document.queryCommandValue('formatBlock').toUpperCase() === 'H2';
        } else {
          active = document.queryCommandState(cmd);
        }
        btn.setAttribute('aria-pressed', active ? 'true' : 'false');
        if (active) {
          btn.classList.add('bg-primary-fixed', 'text-primary');
          btn.classList.remove('text-on-surface-variant');
        } else {
          btn.classList.remove('bg-primary-fixed', 'text-primary');
          btn.classList.add('text-on-surface-variant');
        }
      });
    }

    fmtButtons.forEach(function (btn) {
      btn.addEventListener('mousedown', function (e) {
        e.preventDefault();
        const cmd = btn.getAttribute('data-cmd');
        const val = btn.getAttribute('data-val') || null;
        if (cmd === 'formatBlock') {
          const current = document.queryCommandValue('formatBlock').toUpperCase();
          document.execCommand(cmd, false, current === 'H2' ? 'P' : val);
        } else {
          document.execCommand(cmd, false, val);
        }
        syncToolbarState();
        updateWordCount();
        triggerLocalSave();
      });
    });

    undoBtn.addEventListener('mousedown', function (e) {
      e.preventDefault();
      document.execCommand('undo', false, null);
      syncToolbarState();
      updateWordCount();
      triggerLocalSave();
    });

    editor.addEventListener('input', function () {
      updateWordCount();
      triggerLocalSave();
    });

    editor.addEventListener('keyup', syncToolbarState);
    editor.addEventListener('mouseup', syncToolbarState);
    titleInput.addEventListener('input', triggerLocalSave);
  })();
</script></main></body></html>

