  (function () {
    const filterTabs = document.querySelectorAll('.filter-tab');
    const filesContainer = document.getElementById('files-container');
    const fileCards = Array.from(document.querySelectorAll('.file-card'));
    const viewToggleBtn = document.getElementById('view-toggle-btn');
    const viewToggleIcon = document.getElementById('view-toggle-icon');
    const sortBtn = document.getElementById('sort-btn');
    const sortLabel = document.getElementById('sort-label');

    let isGrid = false;
    let sortMode = 0;
    const sortModes = ['Recent', 'Name', 'Size'];

    filterTabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const filter = tab.getAttribute('data-filter');
        filterTabs.forEach((t) => {
          t.classList.remove('bg-primary-container', 'text-on-primary');
          t.classList.add('bg-surface-container-lowest/75', 'text-on-surface-variant');
        });
        tab.classList.remove('bg-surface-container-lowest/75', 'text-on-surface-variant');
        tab.classList.add('bg-primary-container', 'text-on-primary');

        fileCards.forEach((card) => {
          const type = card.getAttribute('data-type');
          if (filter === 'all' || type === filter) {
            card.classList.remove('hidden');
          } else {
            card.classList.add('hidden');
          }
        });
      });
    });

    viewToggleBtn.addEventListener('click', () => {
      isGrid = !isGrid;
      if (isGrid) {
        filesContainer.classList.remove('flex', 'flex-col');
        filesContainer.classList.add('grid', 'grid-cols-2');
        viewToggleIcon.textContent = 'view_list';
        fileCards.forEach((card) => {
          card.classList.remove('flex-row', 'items-center');
          card.classList.add('flex-col', 'items-start');
          const chevron = card.querySelector('.material-symbols-outlined:last-child');
          if (chevron) chevron.classList.add('hidden');
        });
      } else {
        filesContainer.classList.remove('grid', 'grid-cols-2');
        filesContainer.classList.add('flex', 'flex-col');
        viewToggleIcon.textContent = 'grid_view';
        fileCards.forEach((card) => {
          card.classList.remove('flex-col', 'items-start');
          card.classList.add('flex-row', 'items-center');
          const chevron = card.querySelector('.material-symbols-outlined:last-child');
          if (chevron) chevron.classList.remove('hidden');
        });
      }
    });

    sortBtn.addEventListener('click', () => {
      sortMode = (sortMode + 1) % sortModes.length;
      const mode = sortModes[sortMode];
      sortLabel.textContent = mode;

      const sorted = [...fileCards].sort((a, b) => {
        if (mode === 'Name') {
          return a.getAttribute('data-name').localeCompare(b.getAttribute('data-name'));
        }
        if (mode === 'Size') {
          return Number(b.getAttribute('data-size')) - Number(a.getAttribute('data-size'));
        }
        return Number(a.getAttribute('data-order')) - Number(b.getAttribute('data-order'));
      });

      sorted.forEach((card) => filesContainer.appendChild(card));
    });
  })();
