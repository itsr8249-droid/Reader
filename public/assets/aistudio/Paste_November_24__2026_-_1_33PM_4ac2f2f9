    const recBtn = document.getElementById('rec-btn');
    const recIcon = document.getElementById('rec-icon');
    const recHalo = document.getElementById('rec-halo');
    const recDot = document.getElementById('rec-dot');
    const recStatus = document.getElementById('rec-status');
    const recTimer = document.getElementById('rec-timer');
    const waveBars = document.querySelectorAll('.wave-bar');

    let isRecording = false;
    let seconds = 42;
    let timerInterval = null;
    let waveInterval = null;

    function formatTime(sec) {
      const m = String(Math.floor(sec / 60)).padStart(2, '0');
      const s = String(sec % 60).padStart(2, '0');
      return m + ':' + s;
    }

    function animateWaveform() {
      waveBars.forEach(function (bar) {
        const h = Math.floor(Math.random() * 44) + 10;
        const y = Math.floor((64 - h) / 2);
        bar.setAttribute('height', h);
        bar.setAttribute('y', y);
      });
    }

    recBtn.addEventListener('click', function () {
      isRecording = !isRecording;
      if (isRecording) {
        recIcon.textContent = 'stop';
        recStatus.textContent = 'Recording...';
        recHalo.classList.remove('opacity-0', 'scale-90');
        recHalo.classList.add('opacity-100', 'scale-110', 'animate-pulse');
        recDot.classList.add('scale-125');
        timerInterval = setInterval(function () {
          seconds += 1;
          recTimer.textContent = formatTime(seconds);
        }, 1000);
        waveInterval = setInterval(animateWaveform, 160);
      } else {
        recIcon.textContent = 'mic';
        recStatus.textContent = 'Ready to capture';
        recHalo.classList.add('opacity-0', 'scale-90');
        recHalo.classList.remove('opacity-100', 'scale-110', 'animate-pulse');
        recDot.classList.remove('scale-125');
        clearInterval(timerInterval);
        clearInterval(waveInterval);
      }
    });

    const playButtons = document.querySelectorAll('.play-btn');
    playButtons.forEach(function (btn) {
      btn.addEventListener('click', function () {
        const icon = btn.querySelector('.material-symbols-outlined');
        const isPlaying = icon.textContent.trim() === 'pause';

        playButtons.forEach(function (otherBtn) {
          const otherIcon = otherBtn.querySelector('.material-symbols-outlined');
          otherIcon.textContent = 'play_arrow';
          otherBtn.classList.remove('bg-primary-container', 'text-on-primary');
          otherBtn.classList.add('bg-surface-container-low', 'text-primary-container');
        });

        if (!isPlaying) {
          icon.textContent = 'pause';
          btn.classList.remove('bg-surface-container-low', 'text-primary-container');
          btn.classList.add('bg-primary-container', 'text-on-primary');
        }
      });
    });
  })();
</script></main></body></html>

